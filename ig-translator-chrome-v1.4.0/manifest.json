{
  "manifest_version": 3,
  "name": "Instagram Live Translator with Phyll",
  "version": "1.4.0",
  "description": "Dịch song song hội thoại Instagram Direct siêu tốc & chuẩn xác bằng Gemini API: dịch ngữ cảnh chat, persona, OCR ảnh, phản hồi tức thì.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "contextMenus",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/direct/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mở Instagram Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
